# Copy this file to .env and fill in real values. .env is gitignored — never commit real credentials.

# Buffer GraphQL API credentials — required for /schedule-approved and /pull-analytics (LinkedIn)
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here
BUFFER_CHANNEL_ID=your_linkedin_channel_id_here

# Optional — only needed for the X (Twitter) pipeline: /schedule-approved-x and /pull-analytics-x
BUFFER_CHANNEL_ID_X=your_x_channel_id_here

# Optional: Push Notification webhooks
NOTIFICATION_WEBHOOK_URL=https://your-webhook-endpoint.com

# Required only by mcp-server/ (Claude Desktop / Codex MCP bridge) — absolute path to this repo
# VAULT_ROOT=/absolute/path/to/LinkedIn_Automation
